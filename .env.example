# Copy to .env.local for local development. Placeholder names only; never commit real values.
# When these are absent, the app uses the mock AI client.

# Lovable Cloud (Supabase) project URL and publishable key, used by the browser AI client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Older projects may expose the same key under this name instead.
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Set as a Lovable Cloud secret for the edge functions, never in browser code or this file.
# ANTHROPIC_API_KEY=

# Optional. The published address, so the share card (public/og-image.png) gets an absolute URL.
# VITE_SITE_URL=https://your-site.lovable.app
